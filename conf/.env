# Managed by YunoHost: this file is regenerated on every upgrade and URL change.
# Manual changes are backed up, but will not be kept.

SPOOLMAN_HOST=127.0.0.1
SPOOLMAN_PORT=__PORT__
SPOOLMAN_BASE_PATH=__BASE_PATH__

# Only answer to the YunoHost domain (protects against DNS rebinding)
SPOOLMAN_ALLOWED_HOSTS=__DOMAIN__

# SQLite database, its nightly backups and logs
SPOOLMAN_DB_TYPE=sqlite
SPOOLMAN_DIR_DATA=__DATA_DIR__
SPOOLMAN_DIR_BACKUPS=__DATA_DIR__/backups
SPOOLMAN_DIR_LOGS=/var/log/__APP__
SPOOLMAN_AUTOMATIC_BACKUP=TRUE
SPOOLMAN_LOGGING_LEVEL=INFO

# Updates are handled by YunoHost, not by Spoolman itself
SPOOLMAN_UPDATE_CHECK=FALSE
