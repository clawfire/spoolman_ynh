#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

# Consumed by ynh_config_add: replaces __BASE_PATH__ in conf/.env
# shellcheck disable=SC2034
base_path="$(_spoolman_base_path)"

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Setting up source files..."

ynh_setup_source --dest_dir="$install_dir"

chown -R "$app:www-data" "$install_dir"

#=================================================
# INSTALL PYTHON DEPENDENCIES
#=================================================
ynh_script_progression "Installing Python dependencies (this may take a while)..."

_spoolman_build_venv

#=================================================
# APP INITIAL CONFIGURATION
#=================================================
ynh_script_progression "Adding $app's configuration files..."

ynh_config_add --template=".env" --destination="$install_dir/.env"
chmod 400 "$install_dir/.env"
chown "$app:$app" "$install_dir/.env"

mkdir -p "$data_dir/backups"
chown -R "$app:$app" "$data_dir"
chmod -R o-rwx "$data_dir"

mkdir -p "/var/log/$app"
chown -R "$app:$app" "/var/log/$app"
chmod -R o-rwx "/var/log/$app"

#=================================================
# SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Adding system configurations related to $app..."

ynh_config_add_nginx

ynh_config_add_systemd

yunohost service add "$app" --description="Spoolman filament inventory" --log="/var/log/$app/spoolman.log"

#=================================================
# START SYSTEMD SERVICE
#=================================================
ynh_script_progression "Starting $app's systemd service..."

# First start runs the database migrations
ynh_systemctl --service="$app" --action="start" --wait_until="Application startup complete" --log_path="systemd" --timeout=180

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Installation of $app completed"
